# ── Dependencies ────────────────────────────────────────────────
node_modules
**/node_modules

# ── Build output ────────────────────────────────────────────────
**/.next
**/.turbo
**/*.tsbuildinfo

# ── Env files ───────────────────────────────────────────────────
# Ignore every env file except the committed examples.
# `.env.*` does not match `.env` itself, hence both lines; the negations come
# last so they win regardless of what appears above.
.env
.env.*
!.env.example
!**/.env.example

# ── Local infra state ───────────────────────────────────────────
# Local infra volumes created by `docker:infra:up` (root-owned).
# Anchored to the repo root so it never shadows a source dir named `data`.
# container: sending it as build context bloats the context and can fail with
# "error from sender: ... permission denied".
data/

# ── Editor / IDE ────────────────────────────────────────────────
# Share project editor config; ignore everything else the editor writes.
.idea
.vscode

# ── OS ──────────────────────────────────────────────────────────
.DS_Store

# ── Logs & caches ───────────────────────────────────────────────
*.log

# ── Testing & coverage ──────────────────────────────────────────
coverage
**/coverage

# ── Project-specific ────────────────────────────────────────────
.git
.gitignore
**/dist
# Docker / docs
Dockerfile
.dockerignore
docker-compose*.yml
README.md
docs
