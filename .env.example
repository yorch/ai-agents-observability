# Local development environment
#
# Copy this file to .env, or run `just dev-init`. This file is for apps running
# natively on the host and for the Dockerized development stack. Production
# deployments use .env.production.example instead.
#
# Each variable is documented when added by the relevant task.

# ── Database ──────────────────────────────────────────────────────────────────
# Added by P1-002 (docker-compose stack)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_agents_observability
# Host port the docker:infra Postgres binds to (container side is always 5432).
POSTGRES_PORT=5432
# localhost is for running apps NATIVELY against docker:infra (the dev workflow).
# The dockerized app stacks (docker:app / docker-compose.prod.yml) ignore this
# and build their own URL from POSTGRES_* against the `postgres` service DNS.
# To point prod at a managed DB instead, set DATABASE_URL_OVERRIDE (see below).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_agents_observability

# ── Object Store (MinIO) ──────────────────────────────────────────────────────
# Added by P1-002
# Prod: replace minioadmin creds with real credentials.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Host ports the docker:infra MinIO binds to (S3 API / web console). Keep
# S3_ENDPOINT below in sync if you change MINIO_PORT.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# localhost is for apps running NATIVELY against docker:infra. The dockerized
# app stacks reach MinIO at http://minio:9000 by default; set
# S3_ENDPOINT_OVERRIDE (see below) to use external S3 in prod.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=transcripts
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Added by P1-016
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_HOST=https://github.com
# Optional single-org gate: when set, device-code login (hook token issuance)
# requires the GitHub user to be a member of this org. Needs read:org scope.
# GITHUB_ALLOWED_ORG=

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Added by P1-014
# Ed25519 session-signing keypair (PKCS8 private + SPKI public, PEM). Required
# for login. Generate a local-dev pair with:  bun run gen:keys
# (writes both vars into your .env; pass --force to regenerate)
# JWT_ED25519_PRIVATE_KEY=
# JWT_ED25519_PUBLIC_KEY=

# ── Ingest Service ────────────────────────────────────────────────────────────
# Added by P1-008
INGEST_PORT=4000
GIT_SHA=dev
LOG_LEVEL=info
# Added by P4-007: how long to keep transcript objects in S3/MinIO before deletion.
# 0 = keep forever globally (per-team overrides still apply). Default: 365 days.
# TRANSCRIPT_RETENTION_DAYS=365
# Added by P9-004: upper bound for per-team retention overrides (clamped, not rejected).
# ORG_MAX_RETENTION_DAYS=730
# Optional PAT for the sync-teams job (reads org team membership from GitHub).
# Unset => the job no-ops with a warning.
# GITHUB_SYNC_TOKEN=
# P7-007 spike, declined. Gates the semantic-search prototype; accepts "1" or
# "true". No effect on any production path, and embed-transcripts is not
# scheduled. Leave both unset unless the pgvector decision is revisited.
# SEMANTIC_SEARCH_ENABLED=false
# OPENAI_API_KEY=
# Added by P9-002: public base URL of the web app, used for dashboard links in alert
# notifications. Empty = relative links.
# APP_BASE_URL=https://observability.example.com
# Added by P8-006: gate the cost-reconciliation job. Default: false.
# BILLING_RECONCILIATION_ENABLED=false
# Vendor-cost source for reconcile-cost: an Anthropic Admin API key
# (sk-ant-admin...) for the Cost Report API. When set (and reconciliation is
# enabled), the job compares client-computed cost against Anthropic's billed
# cost for the previous month. Unset => NullBillingSource (no comparison).
# ANTHROPIC_ADMIN_KEY=
# Optional: restrict the Cost Report to one workspace's spend — point it at a
# dedicated Claude Code workspace. Unset => the org's total Anthropic spend.
# ANTHROPIC_COST_WORKSPACE_ID=
# Optional: override the Anthropic API base URL (default https://api.anthropic.com).
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Added by P14-017: the second vendor-cost source, GitHub's AI-credit usage
# report. Wired only when BOTH the token and the scope are set. The figure is
# org-wide (or enterprise-wide, or one personal account) — GitHub publishes no
# per-user breakdown — and covers every AI-credit product on the account, so it
# over-counts against our CLI-only event stream unless GITHUB_BILLING_PRODUCT
# narrows it. Read the "products"/"skus" fields of the job's log line off a real
# response to find the accepted values; the docs do not enumerate them.
# A CLASSIC PAT with billing read access (org owner / billing manager /
# enterprise admin). Fine-grained PATs are not accepted by these endpoints.
# Keep it separate from GITHUB_SYNC_TOKEN: that one needs org:read, this one
# reads the bill.
# GITHUB_BILLING_TOKEN=
# organization | enterprise | user. Default: organization.
# GITHUB_BILLING_SCOPE_KIND=organization
# The org login, enterprise slug, or username matching the scope kind.
# GITHUB_BILLING_SCOPE=
# Optional product filter, e.g. to narrow AI credits to one Copilot surface.
# GITHUB_BILLING_PRODUCT=
# Optional GHES origin (not the API base — https://github.example.com).
# GITHUB_BILLING_HOST=
# Added by P9-002 follow-up: SMTP transport for the email alert channel. The email
# channel only delivers when SMTP_HOST and SMTP_FROM are both set; otherwise email
# alerts fail loud (recorded in alert_delivery_log). SMTP_USER/SMTP_PASSWORD are
# optional (omit for unauthenticated relays). SMTP_SECURE=true for implicit TLS
# (port 465); leave false for STARTTLS (port 587, the default port).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@observability.example.com
# Added by P13-009: the LLM-as-judge runner. Off by default in three independent
# ways — the `judge-sessions` job is seeded disabled, the runner no-ops unless
# BOTH values below are set, and it reads only sessions whose owner ticked
# "Allow automated session evaluation" in Settings → Privacy.
#
# Until P13-011, the judge reads ONLY the sessions of JUDGE_OPERATOR_USER_ID
# (the users.id uuid of the operator running it), which is also the actor
# recorded on the audit row every transcript read writes. Pointing it at anyone
# else is a code change, not a configuration change.
# JUDGE_ANTHROPIC_API_KEY=
# JUDGE_OPERATOR_USER_ID=
# Judge model. Must have a registered revision in packages/schemas/src/judge.ts
# (claude-opus-5, claude-sonnet-5, claude-haiku-4-5) — an unregistered model
# leaves the judge disabled rather than scoring at a borrowed version.
# JUDGE_MODEL=claude-opus-5
# Share of eligible sessions sampled, 0–1. Outcome-negative sessions (reverted
# PR, failed CI, abandoned above JUDGE_HIGH_COST_USD) are always included.
# JUDGE_SAMPLE_RATE=0.1
# JUDGE_HIGH_COST_USD=5
# JUDGE_MAX_SESSIONS_PER_RUN=25

# ── Web / Next.js ─────────────────────────────────────────────────────────────
# Added by P1-024
WEB_PORT=3000
# Optional: base URL for your Jira instance (no trailing slash).
# When set, Jira keys extracted from PR branch names become clickable links.
# NEXT_PUBLIC_JIRA_BASE_URL=https://your-org.atlassian.net
# Optional: point the native web app at the native ingest service. Enables the
# /admin/price-tables view and price-precise routing-savings estimates on /org/models
# (falls back to a flat heuristic when unset). Docker Compose sets its own service URL.
# INGEST_URL=http://localhost:4000
# Optional: business value (USD) of one delivered Jira story point. When set (> 0),
# /org/roi shows value-delivered vs agent-spend, net value, and a return multiple.
# VALUE_PER_STORY_POINT=1500
# Optional: Jira custom field id holding a per-issue business value (currency
# units), e.g. customfield_10032. When set and synced, /org/roi uses the real
# per-issue value (a true external join) instead of the flat VALUE_PER_STORY_POINT
# proxy. Requires JIRA_BASE_URL + JIRA_API_TOKEN.
# JIRA_VALUE_FIELD=

# ── Jira sync (ingest + github-app) ───────────────────────────────────────────
# The sync-jira job runs only when JIRA_BASE_URL and JIRA_API_TOKEN are BOTH set.
# With JIRA_EMAIL set, auth is Basic email:token (Jira Cloud); without it, Bearer
# PAT (Jira Server / Data Center).
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_API_TOKEN=
# JIRA_EMAIL=
# Comma-separated issue-key prefixes the branch-name extractor accepts, unioned
# with the keys sync-jira learns. When empty, any key-shaped token is accepted
# (bootstrap mode). Read by both ingest and github-app.
# JIRA_PROJECT_KEYS=ENG,PLAT
# Instance-specific custom fields. Classic projects need the "Epic Link" field;
# modern projects use `parent` and can leave it unset.
# JIRA_EPIC_LINK_FIELD=customfield_10014
# JIRA_STORY_POINTS_FIELD=customfield_10016

# ── Correlation windows (github-app) ──────────────────────────────────────────
# Sessions starting up to this many days before a PR opened are link candidates.
# PR_LINK_LOOKBACK_DAYS=7
# A default-branch commit is attributed to a session when it lands within the
# session's activity window extended by this many hours (devs routinely commit
# shortly after a session ends).
# COMMIT_LINK_GRACE_HOURS=24

# ── GitHub App ────────────────────────────────────────────────────────────────
# Added by P2-001
# Register a GitHub App at https://github.com/settings/apps/new (or GHES equivalent).
# See docs/github-app-setup.md for full registration instructions.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=      # base64-encoded PEM: base64 -w0 private-key.pem
# GITHUB_APP_WEBHOOK_SECRET=   # openssl rand -hex 32
GITHUB_APP_PORT=4001

# ── GitHub App service ────────────────────────────────────────────────────────
# Added by P2-009
# Optional: gates GET /admin/health (github-app) and POST /admin/jobs/:name/run
# (ingest). When set, these endpoints require a matching X-Admin-Secret header.
# When unset, the endpoints are DISABLED (404).
# ADMIN_SECRET=

# ── Hook ──────────────────────────────────────────────────────────────────────
# Added by P1-020
# Overrides ~/.claude-telemetry (queue.db + hook.log + identity.json)
# CLAUDE_TELEMETRY_HOME=

# ── Observability UI ──────────────────────────────────────────────────────────
# Host ports for the local Prometheus and Grafana containers.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin
