# Production Docker Compose environment
#
# Copy this file to .env.production, or run `just prod-init`, then replace every
# required blank value before starting the stack. Application services receive
# this file with Compose's raw env-file mode so `$` characters in secrets are
# preserved. Values referenced by Compose itself still follow Compose interpolation
# rules; escape a literal `$` in those values as `$$`.

# ── Bundled PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_USER=observability
POSTGRES_PASSWORD=
POSTGRES_DB=ai_agents_observability
# Host binding for operator access. The container always listens on 5432.
POSTGRES_PORT=5432

# Set this instead to point application services and migrations at a managed DB.
# The bundled PostgreSQL container still starts and needs the credentials above.
# URL-encode reserved characters in the username and password.
# DATABASE_URL_OVERRIDE=postgresql://user:password@db.example.com:5432/ai_agents_observability

# ── Bundled MinIO / S3 ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=transcripts
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Set all three credential/endpoint overrides together for an external S3 service.
# S3_ENDPOINT_OVERRIDE=https://s3.amazonaws.com
# S3_ACCESS_KEY_ID_OVERRIDE=
# S3_SECRET_ACCESS_KEY_OVERRIDE=

# ── Authentication (required for login) ────────────────────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_HOST=https://github.com
# GitHub OAuth App setting (not the GitHub App webhook):
#   Authorization callback URL: https://observability.example.com/api/auth/callback
# Optional single-org gate. Requires the OAuth app's read:org scope.
# GITHUB_ALLOWED_ORG=

# Generate this Ed25519 pair after creating .env.production:
#   just prod-keys
# JWT_ED25519_PRIVATE_KEY=
# JWT_ED25519_PUBLIC_KEY=

# ── GitHub App webhook service (required) ──────────────────────────────────────
GITHUB_APP_ID=
# Base64-encoded PEM: base64 < private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PORT=4001
# GitHub App UI settings (configure these on GitHub; they are not service env vars):
#   Homepage URL: https://observability.example.com
#   Webhook URL:  https://github-app.example.com/webhooks/github
# For local development, use https://smee.io/<channel> as the Webhook URL and
# run: bunx smee-client --url https://smee.io/<channel> --path /webhooks/github --port 4001
# PR_LINK_LOOKBACK_DAYS=7
# COMMIT_LINK_GRACE_HOURS=24

# ── Application services ───────────────────────────────────────────────────────
WEB_PORT=3000
INGEST_PORT=4000
LOG_LEVEL=info
# Set to the deployed release or commit for /health build metadata.
GIT_SHA=
# Public web URL used in alert links.
# APP_BASE_URL=https://observability.example.com
# Protects enabled admin endpoints when set; unset keeps them disabled.
# ADMIN_SECRET=
# TRANSCRIPT_RETENTION_DAYS=365
# ORG_MAX_RETENTION_DAYS=730

# Optional Jira links and synchronization.
# NEXT_PUBLIC_JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_API_TOKEN=
# JIRA_EMAIL=
# JIRA_PROJECT_KEYS=ENG,PLAT
# JIRA_EPIC_LINK_FIELD=customfield_10014
# JIRA_STORY_POINTS_FIELD=customfield_10016
# JIRA_VALUE_FIELD=customfield_10032
# VALUE_PER_STORY_POINT=1500

# Optional team synchronization.
# GITHUB_SYNC_TOKEN=

# Optional billing reconciliation.
# BILLING_RECONCILIATION_ENABLED=false
# ANTHROPIC_ADMIN_KEY=
# ANTHROPIC_COST_WORKSPACE_ID=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GITHUB_BILLING_TOKEN=
# GITHUB_BILLING_SCOPE_KIND=organization
# GITHUB_BILLING_SCOPE=
# GITHUB_BILLING_PRODUCT=
# GITHUB_BILLING_HOST=

# Optional SMTP alert delivery. SMTP_HOST and SMTP_FROM enable the channel.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=alerts@observability.example.com

# Optional LLM-as-judge runner. Both key and operator are required; the scheduled
# job remains disabled until explicitly enabled in the application.
# JUDGE_ANTHROPIC_API_KEY=
# JUDGE_OPERATOR_USER_ID=
# JUDGE_MODEL=claude-opus-5
# JUDGE_SAMPLE_RATE=0.1
# JUDGE_HIGH_COST_USD=5
# JUDGE_MAX_SESSIONS_PER_RUN=25

# Declined semantic-search prototype; leave unset unless the decision is revisited.
# SEMANTIC_SEARCH_ENABLED=false
# OPENAI_API_KEY=

# ── Images ─────────────────────────────────────────────────────────────────────
# Pin all four images to the same approved release. The Compose defaults track
# `main`, which is convenient for testing but not a production pin.
APP_IMAGE_WEB=ghcr.io/yorch/ai-agents-observability/web:v1.2.0
APP_IMAGE_INGEST=ghcr.io/yorch/ai-agents-observability/ingest:v1.2.0
APP_IMAGE_GITHUB=ghcr.io/yorch/ai-agents-observability/github-app:v1.2.0
APP_IMAGE_MIGRATIONS=ghcr.io/yorch/ai-agents-observability/migrations-runner:v1.2.0

# ── Prometheus / Grafana ───────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=

# ── Optional Traefik overlay ───────────────────────────────────────────────────
# DOMAIN_APP=observability.example.com
# DOMAIN_GITHUB=observability-github.example.com
# TRAEFIK_NAME_WEB=ai-agents-web
# TRAEFIK_NAME_GITHUB=ai-agents-github

# ── Optional Watchtower overlay ────────────────────────────────────────────────
# WATCHTOWER_POLL_INTERVAL=86400
# WATCHTOWER_SCOPE=ai-agents-observability
