# Temporary scripts / scratch files
/tmp/

# Data — root-level stack bind mounts only (Postgres/MinIO/Prometheus/Grafana).
# Anchored with a leading slash so it does NOT match app-level data dirs such as
# apps/ingest/src/data/ (which holds committed price-table JSON).
/data/

# Env files: ignore everything except the committed examples.
# `.env.*` does not match `.env` itself, hence both lines. Negations come last
# so they win regardless of what is above.
.env
.env.*
!.env.example
!.env.*.example

# Editor config: share project settings, ignore everything else VS Code writes.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
